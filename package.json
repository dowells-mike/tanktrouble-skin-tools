{
  "name": "tanktrouble-skin-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial cosmetic Chrome extension for TankTrouble: custom tank skins and recolours on your own screen only.",
  "author": "Bleed (Dowells)",
  "license": "MIT",
  "homepage": "https://github.com/dowells-mike/tanktrouble-skin-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dowells-mike/tanktrouble-skin-tools.git"
  },
  "bugs": {
    "url": "https://github.com/dowells-mike/tanktrouble-skin-tools/issues"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "audit": "node build/audit.mjs",
    "test": "node --test tests/unit.test.mjs",
    "check": "node build/build.mjs && node tests/release.check.mjs",
    "reproducible": "node build/reproducible.mjs",
    "starter-kit": "node starter-kit/build.mjs",
    "test:starter-kit": "node --test tests/starter-kit.test.mjs",
    "check:starter-kit": "node starter-kit/build.mjs && node tests/starter-kit.check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.62.1"
  }
}
