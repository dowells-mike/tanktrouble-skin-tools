{
  "manifest_version": 3,
  "name": "TankTrouble Skin Tools",
  "version": "1.0.0",
  "description": "Unofficial. Custom tank skins and recolours for TankTrouble, on your own screen only. No network, no gameplay changes.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://tanktrouble.com/*"],
      "js": ["src/frames.js", "src/resample.js", "src/core.js", "src/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://tanktrouble.com/*"],
      "js": ["src/png-info.js", "src/skin-package.js", "src/store.js", "src/importer.js", "src/preview.js", "src/panel.js", "src/main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
